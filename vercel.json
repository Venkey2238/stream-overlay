{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/main.py" },
    { "source": "/login", "destination": "/main.py" },
    { "source": "/auth/(.*)", "destination": "/main.py" },
    
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/overlay", "destination": "/public/overlay.html" },
    { "source": "/chat", "destination": "/main.py" },
    { "source": "/", "destination": "/public/dashboard.html" }
  ]
}
